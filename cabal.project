packages:
    sentry
  , sentry-core

source-repository-package
    type: git
    location: https://github.com/jkachmar/patrol
    branch: main

constraints:
  hs-opentelemetry-api >= 0.3.0.0

allow-newer:
    hs-opentelemetry-instrumentation-http-client:hs-opentelemetry-api
  , hs-opentelemetry-instrumentation-conduit:hs-opentelemetry-api
