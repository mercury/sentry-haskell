# filter a haskell package set for the following deps
hp:
let
  names = [
    "aeson"
    "annotated-exception"
    "async"
    "atomic-primops"
    "attoparsec"
    "crypton-connection"
    "data-default"
    "file-embed"
    "hspec"
    "http-client"
    "http-client-tls"
    "http-semantics"
    "http-types"
    "http2"
    "network"
    "network-bsd"
    "network-run"
    "network-uri"
    "pretty-simple"
    "random"
    "safe-exceptions"
    "tasty"
    "tasty-bench"
    "tasty-hspec"
    "tls"
    "typed-process"
    "unagi-chan"
    "unliftio"
    "unliftio-core"
    "unordered-containers"
    "vector"
    "wai"
    "warp"
    "warp-tls"
    "weigh"
    "witch"
    "zlib"
  ];
in
builtins.filter (p: p != null) (map (name: hp.${name} or null) names)
